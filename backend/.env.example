# ─────────────────────────────────────────────────────────────────────────────
# Five Two Supports — Ticketing Backend — Environment Configuration
# Copy to `.env` and adjust. All values are validated at boot (fail-fast).
# Covers runtime, auth, email/SES, MinIO storage, jobs, rate limiting, observability.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Datastores
# For docker-compose, these are overridden to the service hostnames (mongo/redis).
MONGODB_URI=mongodb://localhost:27017/ticketing
REDIS_URL=redis://localhost:6379

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# CORS: comma-separated list of allowed browser origins (the web app).
CORS_ORIGINS=http://localhost:5173

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# REQUIRED. Generate strong values: `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL_SECONDS=900       # access token lifetime (15 min)
JWT_REFRESH_TTL_SECONDS=604800   # refresh token lifetime (7 days)
BCRYPT_COST=12
PASSWORD_RESET_TTL_MINUTES=30

# ── Refresh-token cookie ────────────────────────────────────────────────────
REFRESH_COOKIE_NAME=fts_refresh
COOKIE_SECURE=false              # set true behind HTTPS in production
COOKIE_SAMESITE=lax              # lax | strict | none
# COOKIE_DOMAIN=.fivetwosupports.com

# ── Bootstrap admin (npm run seed) ──────────────────────────────────────────
BOOTSTRAP_ADMIN_NAME=Five Two Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# ── Email ───────────────────────────────────────────────────────────────────
MAIL_PROVIDER=noop                 # noop | ses
MAIL_FROM=Five Two Supports <no-reply@fivetwosupports.local>
WEB_URL=http://localhost:5173      # base URL used for links in emails
# Required when MAIL_PROVIDER=ses (or rely on the AWS default credential chain):
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Background jobs / scheduling ────────────────────────────────────────────
RESOLUTION_REMINDER_DAYS=5
AUTO_CLOSE_DAYS=7
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=5000

# ── Object storage (MinIO / S3) ─────────────────────────────────────────────
STORAGE_DRIVER=memory              # memory | s3  (use s3 with MinIO for real files)
# S3_ENDPOINT=http://localhost:9000  # MinIO endpoint
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=ticket-attachments
# S3_FORCE_PATH_STYLE=true           # required for MinIO

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000         # general limiter window (1 min)
RATE_LIMIT_MAX=300                 # requests / window / IP across the API
AUTH_RATE_LIMIT_WINDOW_MS=900000   # auth limiter window (15 min)
AUTH_RATE_LIMIT_MAX=30             # auth requests / window / IP

# ── Login lockout (brute-force protection) ──────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Observability ───────────────────────────────────────────────────────────
# SENTRY_DSN=                      # set to enable Sentry error tracking
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_ENABLED=true               # exposes GET /metrics (Prometheus format)
