# Frontend environment (Vite). Variables must be prefixed with VITE_.

# Base path of the backend REST API. In dev this is proxied to the backend
# (see vite.config.ts), so a relative path keeps cookies same-origin.
VITE_API_URL=/api/v1

# Socket.IO origin. Empty = same origin (proxied in dev). In production set the
# API origin, e.g. https://api.fivetwosupports.com
VITE_SOCKET_URL=
